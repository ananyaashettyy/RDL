{
  "name": "attendance-system",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "axios": "^1.6.7"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis",
    "test:cases": "node scripts/testcases.js run",
    "test:report": "node scripts/testcases.js report",
    "test:watch": "node scripts/testcases.js watch",
    "test:merge": "node scripts/testcases.js merge --remove",
    "test:xlsx": "node scripts/testcases.js xlsx --in testing/test-cases.csv --out testing/test-case.xlsx --sheet \"Test Cases\""
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "extends": null,
    "appId": "com.rdl.attendance",
    "productName": "RDL Attendance",
    "executableName": "RDL Attendance",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 edge version"
    ]
  },
  "proxy": "http://localhost/attendance-api"
}
